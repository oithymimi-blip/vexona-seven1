# TokenGateway Backend — Environment Variables
# Copy this to .env and fill in your values

PORT=8787

# BNB Chain RPC
RPC_URL=https://bsc-dataseed.binance.org

# Private key of the wallet that owns (deployed) TokenGateway
ADMIN_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Deployed TokenGateway contract address
GATEWAY_ADDRESS=0xYOUR_GATEWAY_ADDRESS_HERE

# Secret key to protect admin API endpoints
ADMIN_API_KEY=change-me-use-a-long-random-string

# Optional: default fee in basis points (0–1000). 100 = 1%.
FEE_BPS=100

# Optional: treasury wallet address for fee collection
TREASURY=0xYOUR_TREASURY_ADDRESS_HERE

# Cloud Database (Turso SQLite — persists forever on Vercel)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
