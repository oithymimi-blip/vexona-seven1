{
  "version": 2,
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/super", "destination": "/super.html" },
    { "source": "/ref(.*)", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/$1" }
  ]
}
